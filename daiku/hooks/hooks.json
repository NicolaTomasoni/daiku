{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/command-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Destructive command guard"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/edit-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Coarse edit perimeter"
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/run-advice.mjs\"",
            "timeout": 15,
            "statusMessage": "Daiku run boundary in this conversation"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/contracts-post-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Deterministic corpus checks"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/session-advice.mjs\"",
            "timeout": 10,
            "statusMessage": "Daiku status for this project"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/run-advice.mjs\"",
            "timeout": 15,
            "statusMessage": "Daiku run boundary in this conversation"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/stop-advice.mjs\"",
            "timeout": 10,
            "statusMessage": "Open review ledgers"
          }
        ]
      }
    ]
  }
}
