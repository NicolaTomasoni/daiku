{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "LLM: switch to DeepSeek V4.1 Flash (OpenCode Go)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${env:USERPROFILE}\\.claude\\llm-switch.ps1",
        "-Mode",
        "go",
        "-GoModel",
        "deepseek-v4.1-flash"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "LLM: switch to Claude Code",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${env:USERPROFILE}\\.claude\\llm-switch.ps1",
        "-Mode",
        "claude"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "LLM: status",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${env:USERPROFILE}\\.claude\\llm-switch.ps1",
        "-Mode",
        "status"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Nuovo progetto: crea e pubblica su GitLab",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/.docs/scripts/new-project.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "Daiku: gestisci guardie (amministratore)",
      "type": "shell",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "C:\\Program Files\\ClaudeCode\\tools\\gestisci-guardie.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "shared"
      }
    },
    {
      "label": "daiku: update",
      "detail": "Show the Daiku version in place, then on your answer refresh the daiku marketplace and update the plugin on Claude Code",
      "type": "shell",
      "command": "node .daiku/update.mjs",
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": []
    }
  ]
}
