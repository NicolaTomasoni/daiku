{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",

  "permissions": {
    "deny": [
      "Bash(npm test *)",
      "Bash(npm run *)",
      "Bash(yarn *)",
      "Bash(pnpm *)",
      "Bash(make *)",
      "Bash(cargo *)",
      "PowerShell(npm test *)",
      "PowerShell(npm run *)",
      "PowerShell(yarn *)",
      "PowerShell(pnpm *)",
      "PowerShell(make *)",
      "PowerShell(cargo *)"
    ]
  },

  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia-target.mjs\"",
            "timeout": 15,
            "statusMessage": "Presidio del target"
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PROJECT_DIR}/.claude/hooks/guardia-target.mjs\"",
            "timeout": 15,
            "statusMessage": "Presidio del target"
          }
        ]
      }
    ]
  }
}
