+function nuovaCartella(nome) {
+  const dir = join(tmpdir(), `daiku-corsa-banco-${process.pid}-${nome}`)
+  for (const p of [dir, featureDir(dir), readmeFinto(dir), `${dir}-lista.md`]) rmSync(p, { recursive: true, force: true })
