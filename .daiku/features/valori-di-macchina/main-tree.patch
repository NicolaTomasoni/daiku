-/** Una chiave dello schema (`areas.<area>.gate`) diventa il modello che la riconosce. */
-function modelloDiChiave(chiave) {
-  const pezzi = chiave
-    .split('.')
-    .map((pezzo) => (/^<.+>$/.test(pezzo) ? '[^.]+' : pezzo.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')));
-  return new RegExp('^' + pezzi.join('\\.') + '$');
-}
