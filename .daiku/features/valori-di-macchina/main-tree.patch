-/** Le chiavi di un oggetto JSON in forma puntata, per confrontarle con lo schema. */
-function chiaviDiPiu(dati, prefisso) {
-  const fuori = [];
-  const scendi = (valore, cammino) => {
-    if (!valore || typeof valore !== 'object' || Array.isArray(valore)) return;
