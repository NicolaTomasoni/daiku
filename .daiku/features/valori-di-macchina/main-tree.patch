++
++const CAMPI_ASSI_A = ['- **In Daiku oggi:**', '- **Nel target:**', '- **Chi vince:**', '- **Proposta:**']
++const CAMPI_ASSI_B = ['- **Capacità:**', '- **Nel target:**', '- **Proposta:**']
++
++const SEZIONI_SINTESI = [
