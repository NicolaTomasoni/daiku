++  '## Interventi approvati',
++  '## Dove i target divergono, e chi vince',
++  '## Cosa resta aperto',
++  '## Limiti',
++]
++
++const CAMPI_SINTESI = ['- **Corsa:**', '- **Data:**', '- **Target studiati:**', '- **Esito:**']
++const CAMPI_INTERVENTO = ['- **Cosa cambia:**', '- **Dove atterra:**', '- **Perché subito:**', '- **Da quale target:**']
