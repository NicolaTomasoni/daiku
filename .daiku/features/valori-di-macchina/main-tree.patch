-/** Le forme di comando d'installazione che nessuno script della cartella deve contenere. */
-const INSTALL_PATTERNS = [
-  /\b(npm|pnpm|yarn)\s+(i|install|ci|add)\b/,
-  /\bpip3?\s+install\b/,
-  /\b-m\s+pip\s+install\b/,
