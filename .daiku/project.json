{
  "contract": 1,
  "name": "daiku-dev",
  "repo_root": "C:/dev/daiku",
  "code_root": "plugins/",
  "language": {
    "chat": "it",
    "commit": "it"
  },
  "changelog": "plugins/CHANGELOG.md",
  "version": {
    "file": "plugins/daiku/.claude-plugin/plugin.json",
    "field": "version",
    "replicated_in": [
      "plugins/daiku/.codex-plugin/plugin.json",
      "plugins/README.md"
    ]
  },
  "paths": {
    "studies": ".daiku/studies",
    "features": ".daiku/features",
    "review_state": ".docs/runtime/review"
  },
  "memory": {
    "root": ".docs/memory",
    "index": ".docs/memory/MEMORY.md"
  },
  "commit": {
    "memory_prefix": "docs(memoria)"
  },
  "review": {
    "disciplines": ["bug"]
  },
  "channels": {
    "development": "develop",
    "production": "main"
  },
  "release": {
    "source": "plugins"
  },
  "worktree": {
    "pool": ".claude/worktrees",
    "prefix": "agent-tree-",
    "max": 5,
    "branch_prefix": "worktree-"
  },
  "areas": {
    "daiku": {
      "paths": ["plugins/daiku/"],
      "gate": {
        "cwd": ".",
        "run": ["node .docs/tools/check-corpus.mjs plugins/daiku"]
      }
    }
  }
}
