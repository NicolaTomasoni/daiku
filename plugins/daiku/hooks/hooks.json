{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/command-guard.mjs\"",
            "timeout": 15,
            "statusMessage": "Guardia comandi distruttivi"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/contracts-post-edit.mjs\"",
            "timeout": 30,
            "statusMessage": "Controlli deterministici sul corpus"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/lib/session-advice.mjs\"",
            "timeout": 10,
            "statusMessage": "Stato di Daiku sul progetto"
          }
        ]
      }
    ]
  }
}
